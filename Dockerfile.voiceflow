# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS builder

WORKDIR /src
COPY xyops/entry.ts ./xyops/entry.ts
COPY xyops/voiceflow ./xyops/voiceflow

RUN mkdir -p /opt/voiceflow \
  && bun build --target=node --format=esm --outfile=/opt/voiceflow/entry.mjs xyops/entry.ts

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

LABEL org.opencontainers.image.title="XYOps Voiceflow runner"

COPY --from=builder /opt/voiceflow/entry.mjs /opt/voiceflow/entry.mjs

USER node
ENTRYPOINT ["node", "/opt/voiceflow/entry.mjs"]
